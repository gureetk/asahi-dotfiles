// ~/.config/waybar/config.jsonc
// Reload the bar after editing: Ctrl+Shift+C (reloads sway and waybar)
{
    "layer": "top",
    "position": "top",
    "height": 30,
    "margin-top": 6,
    "margin-left": 8,
    "margin-right": 8,
    "spacing": 6,

    "modules-left": ["custom/launcher", "sway/workspaces", "sway/mode", "sway/scratchpad"],
    "modules-center": ["clock", "custom/dnd"],
    "modules-right": ["tray", "group/status", "custom/control"],

    "custom/launcher": {
        "format": "",
        "tooltip-format": "Apps (Ctrl+D)",
        "on-click": "fuzzel"
    },

    "sway/workspaces": {
        "disable-scroll": true,
        "format": "{name}"
    },

    "sway/mode": {
        "format": "{}"
    },

    "sway/scratchpad": {
        "format": "<span font_family='Font Awesome 6 Free' font_weight='900'></span>  {count}",
        "show-empty": false,
        "tooltip-format": "{app}: {title}",
        "on-click": "swaymsg 'scratchpad show'"
    },

    "clock": {
        "format": "{:%a %b %d   %H:%M}",
        "tooltip-format": "<tt>{calendar}</tt>",
        "on-click": "~/.config/sway/scripts/notifications.sh",
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up": "shift_down",
            "on-scroll-down": "shift_up"
        },
        "calendar": {
            "mode": "month",
            "format": {
                "today": "<span color='#7aa2f7'><b>{}</b></span>"
            }
        }
    },

    "custom/dnd": {
        "exec": "~/.config/waybar/scripts/dnd-status.sh",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "~/.config/sway/scripts/toggle.sh dnd"
    },

    "tray": {
        "icon-size": 16,
        "spacing": 10
    },

    "group/status": {
        "orientation": "horizontal",
        "modules": ["network", "bluetooth", "pulseaudio", "backlight", "battery"]
    },

    "network": {
        "interval": 5,
        "format-wifi": "",
        "format-ethernet": "",
        "format-disconnected": "",
        "format-disabled": "",
        "tooltip-format-wifi": "{essid}  ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "tooltip-format-disconnected": "Not connected",
        "tooltip-format-disabled": "Wi-Fi is off",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/network_menu.xml",
        "menu-actions": {
            "wifi-pick": "~/.config/sway/scripts/wifi.sh",
            "wifi-toggle": "~/.config/sway/scripts/toggle.sh wifi",
            "net-settings": "nm-connection-editor"
        }
    },

    "bluetooth": {
        "format": "",
        "format-off": "",
        "format-disabled": "",
        "format-connected": "",
        "format-no-controller": "",
        "tooltip-format": "Bluetooth: {status}",
        "tooltip-format-connected": "Connected:\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/bluetooth_menu.xml",
        "menu-actions": {
            "bt-pick": "~/.config/sway/scripts/bluetooth.sh",
            "bt-toggle": "~/.config/sway/scripts/toggle.sh bluetooth",
            "bt-pair": "blueman-manager"
        },
        "on-click-right": "~/.config/sway/scripts/toggle.sh bluetooth"
    },

    "pulseaudio": {
        "format": "{icon}",
        "format-muted": "",
        "format-icons": {
            "default": ["", "", ""]
        },
        "tooltip-format": "{desc}: {volume}%\n\nClick for sliders, scroll to change, right-click to mute",
        "on-scroll-up": "~/.config/sway/scripts/osd.sh volume up",
        "on-scroll-down": "~/.config/sway/scripts/osd.sh volume down",
        "on-click": "~/.config/sway/scripts/quick-panel.py",
        "on-click-right": "~/.config/sway/scripts/osd.sh volume mute"
    },

    "backlight": {
        "format": "",
        "tooltip-format": "Brightness {percent}%\n\nClick for sliders, scroll to change",
        "on-scroll-up": "~/.config/sway/scripts/osd.sh brightness up",
        "on-scroll-down": "~/.config/sway/scripts/osd.sh brightness down",
        "on-click": "~/.config/sway/scripts/quick-panel.py"
    },

    "battery": {
        "interval": 30,
        "states": {
            "warning": 25,
            "critical": 12
        },
        "format": "<span font_family='Font Awesome 6 Free' font_weight='900'>{icon}</span>  {capacity}%",
        "format-charging": "<span font_family='Font Awesome 6 Free' font_weight='900'></span>  {capacity}%",
        "format-plugged": "<span font_family='Font Awesome 6 Free' font_weight='900'></span>  {capacity}%",
        "format-icons": ["", "", "", "", ""],
        "tooltip-format": "{timeTo}\n\nClick for details and power mode",
        "on-click": "~/.config/sway/scripts/quick-panel.py"
    },

    "custom/control": {
        "format": "",
        "tooltip-format": "Quick settings",
        "menu": "on-click",
        "menu-file": "~/.config/waybar/control_menu.xml",
        "menu-actions": {
            "wifi": "~/.config/sway/scripts/wifi.sh",
            "bluetooth": "~/.config/sway/scripts/bluetooth.sh",
            "sound": "pavucontrol",
            "wifi-toggle": "~/.config/sway/scripts/toggle.sh wifi",
            "bluetooth-toggle": "~/.config/sway/scripts/toggle.sh bluetooth",
            "dnd": "~/.config/sway/scripts/toggle.sh dnd",
            "screenshot": "~/.config/sway/scripts/screenshot.sh area",
            "wallpaper": "~/.config/sway/scripts/wallpaper.sh",
            "scale": "~/.config/sway/scripts/scale.sh",
            "keybinds": "~/.config/sway/scripts/keybinds.sh",
            "power-settings": "~/.config/sway/scripts/power-settings.sh",
            "lock": "~/.config/sway/scripts/lock.sh",
            "suspend": "systemctl suspend",
            "logout": "swaymsg exit",
            "reboot": "systemctl reboot",
            "poweroff": "systemctl poweroff"
        }
    }
}
